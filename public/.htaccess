Redirect 301 /ia.html /inteligencia-artificial/

<IfModule mod_setenvif.c>
  SetEnvIfExpr "%{HTTPS} == 'on'" vogel_https
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), geolocation=(), microphone=()"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000" env=vogel_https
</IfModule>
