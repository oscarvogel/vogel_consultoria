Redirect 301 /ia.html /inteligencia-artificial/
Redirect 301 /info/ /estudio/

# Unknown URLs: the SPA fallback renders the NotFound page (React Router prerender, ssr:false).
ErrorDocument 404 /__spa-fallback.html

<IfModule mod_setenvif.c>
  SetEnvIfExpr "%{HTTPS} == 'on'" vogel_https
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), geolocation=(), microphone=()"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000" env=vogel_https
</IfModule>
