      "id": "extract-text",
      "name": "Extraer texto",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [760, 400]
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.data || $json.text || $json.content || '';\nconst sourcePath = $json.fileName || $json.filePath || $json.path || '';\nconst match = raw.match(/^---\\s*\\n([\\s\\S]*?)\\n---\\s*\\n([\\s\\S]*)$/);\nif (!match) { throw new Error(`El archivo no tiene front matter valido: ${sourcePath}`); }\nconst metaText = match[1];\nconst body = match[2].trim();\nconst meta = {};\nfor (const line of metaText.split(/\\r?\\n/)) {\n  const item = line.match(/^([A-Za-z0-9_-]+):\\s*\"(.*)\"\\s*$/) || line.match(/^([A-Za-z0-9_-]+):\\s*(.*)\\s*$/);\n  if (item) meta[item[1]] = item[2].trim();\n}\nif (meta.estado !== 'aprobada') return [];\nif (!body) throw new Error(`La publicacion no tiene texto: ${sourcePath}`);\nreturn [{ json: { id: meta.id, canal: meta.canal || 'linkedin', estado: meta.estado, fecha_sugerida: meta.fecha_sugerida || '', imagen: meta.imagen || '', texto: body, sourcePath } }];"
      },
      "id": "parse-approved",
      "name": "Parsear aprobada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1000, 400]
    },
    {
      "parameters": {
        "resource": "post",
        "operation": "create",
        "text": "={{ $json.texto }}",
        "additionalFields": {}
      },
